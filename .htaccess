# ---- Argent: protect data & include-only files (Apache / LiteSpeed on Hostinger) ----
Options -Indexes

# Database files, dumps, backups must never be downloadable
<FilesMatch "\.(sqlite|sqlite3|db|sql|bak|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Include-only PHP files (no direct access)
<FilesMatch "^(db|auth|compat|layout|report_lib|import_lib|proofs)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Never cache dynamic pages
<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "SAMEORIGIN"
        Header set Referrer-Policy "same-origin"
    </FilesMatch>
</IfModule>
